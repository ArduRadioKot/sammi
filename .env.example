APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://sammi:change-me@db:5432/sammi
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

POSTGRES_DB=sammi
POSTGRES_USER=sammi
POSTGRES_PASSWORD=change-me

# Credits — internal units, not rubles. Granted once per workspace on first access.
CREDITS_INITIAL_GRANT=1000

# AI providers — leave empty to keep a provider unconfigured.
# Ollama on the host is http://localhost:11434. From a Docker API container use host.docker.internal:11434 on macOS.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60

YANDEX_AI_API_KEY=
YANDEX_AI_PROJECT_ID=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=

CSV_MAX_FILE_SIZE_MB=10
CSV_MAX_ROWS=10000
CSV_PREVIEW_ROWS=20

DADATA_API_KEY=
DADATA_BASE_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs
DADATA_TIMEOUT_SECONDS=15
DADATA_COMPANY_LOOKUP_CREDITS=1
ENRICHMENT_SYNC_MAX_ROWS=50
ENRICHMENT_PROVIDER_CONCURRENCY=5
ENRICHMENT_STORE_RAW_RESPONSES=false

TEST_DATABASE_URL=postgresql+asyncpg://sammi:change-me@localhost:5432/sammi_test

VITE_API_URL=http://localhost:8000
VITE_ENABLE_DEMO_DATA=false
